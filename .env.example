# Mailchimp newsletter integration (server-only; never prefix secrets with NEXT_PUBLIC_)
MAILCHIMP_API_KEY=replace-with-your-mailchimp-api-key
MAILCHIMP_AUDIENCE_ID=replace-with-your-audience-id
MAILCHIMP_CAMPAIGN_NAME="Sunstone Cities"
# The signup form explicitly requests email updates, so add the contact immediately.
MAILCHIMP_SUBSCRIPTION_STATUS=subscribed

# Contact form Resend integration (server-only)
RESEND_API_KEY=replace-with-your-resend-api-key
CONTACT_TO_EMAIL=Projects@P3LLC.net
CONTACT_FROM_EMAIL="Epictopia <contact@mail.epictopia.ai>"
